# Cloudflare Configuration
# Get your Token: https://dash.cloudflare.com/profile/api-tokens
# Get your ID: https://dash.cloudflare.com/ (check URL)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Brand Configuration
# Change these to create your own branded fork
JONSOC_BRAND=jonsoc
JONSOC_DOMAIN=jonsoc.com
JONSOC_API_DOMAIN=api.jonsoc.com
JONSOC_DOCS_DOMAIN=docs.jonsoc.com

# MODELS INFRASTRUCTURE (IMPORTANT READ THIS)
# MODELS_URL defaults to https://models.dev (opencode.ai's hosted models service)
# This is intentional - models like minimax/m2.1 are hosted by opencode.ai and
# require their infrastructure. Most forks want their own branding while still using
# opencode.ai's model discovery and hosted models.
#
# To use your own models infrastructure, you MUST explicitly set OPENCODE_MODELS_URL:
#   OPENCODE_MODELS_URL=https://your-models-domain.com
#
# If unset, it will use models.dev (opencode.ai's free hosted models service)
OPENCODE_MODELS_URL=

# LEGACY OPENCODE CONFIG SUPPORT
# Always enabled: opencode.json and .opencode/ are always read.

JONSOC_INSTALL_URL=https://jonsoc.com/install
JONSOC_CONFIG_SCHEMA=https://jonsoc.com/config.json
JONSOC_REPO=Noisemaker111/Jonsoc
JONSOC_APP_NAME=jonsoc
JONSOC_NPM_PACKAGE=jonsoc
JONSOC_HOMEBREW_TAP=Noisemaker111/homebrew-tap

# CLI Configuration
JONSOC_CLI_NAME=jonsoc

# Development
JONSOC_TEST_HOME=
JONSOC_WORKDIR=

# Feature Flags
JONSOC_DISABLE_SHARE=false
JONSOC_DISABLE_AUTOUPDATE=false
JONSOC_DISABLE_PRUNE=false
JONSOC_DISABLE_MODELS_FETCH=false
JONSOC_ENABLE_EXPERIMENTAL_MODELS=false

# GitHub Integration
OIDC_BASE_URL=
