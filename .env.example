# Brand Configuration
# Change these to create your own branded fork
JONSOC_BRAND=jonsoc
JONSOC_DOMAIN=jonsoc.ai
JONSOC_API_DOMAIN=api.jonsoc.ai
JONSOC_DOCS_DOMAIN=docs.jonsoc.ai

# MODELS INFRASTRUCTURE (IMPORTANT READ THIS)
# MODELS_URL defaults to https://models.dev (opencode.ai's hosted models service)
# This is intentional - models like minimax/m2.1 are hosted by opencode.ai and
# require their infrastructure. Most forks want their own branding while still using
# opencode.ai's model discovery and hosted models.
#
# To use your own models infrastructure, you MUST explicitly set OPENCODE_MODELS_URL:
#   OPENCODE_MODELS_URL=https://your-models-domain.com
#
# If unset, it will use models.dev (opencode.ai's free hosted models service)
OPENCODE_MODELS_URL=

# LEGACY OPENCODE CONFIG SUPPORT (MIGRATION HELP)
# By default, this is ENABLED (true) to allow easy migration from opencode.
# You can read your existing opencode.json, .opencode/ directory configs, etc.
# This allows you to gradually migrate configs without breaking anything.
#
# Set to "true" (default) to allow reading opencode.json and .opencode/ configs
# Set to "false" to ONLY use your brand's configs (e.g., jonsoc.json, .jonsoc/)
#
# Default: "true" - legacy configs are allowed by default
# Set to "false" to opt-out and use only your brand's configs:
JONSOC_ALLOW_LEGACY_OPENCODE_CONFIGS=true

JONSOC_INSTALL_URL=https://jonsoc.ai/install
JONSOC_CONFIG_SCHEMA=https://jonsoc.ai/config.json
JONSOC_REPO=Noisemaker111/Jonsoc
JONSOC_APP_NAME=jonsoc
JONSOC_NPM_PACKAGE=jonsoc-ai
JONSOC_HOMEBREW_TAP=sst/homebrew-tap

# CLI Configuration
JONSOC_CLI_NAME=jonsoc

# Development
JONSOC_TEST_HOME=
JONSOC_WORKDIR=

# Feature Flags
JONSOC_DISABLE_SHARE=false
JONSOC_DISABLE_AUTOUPDATE=false
JONSOC_DISABLE_PRUNE=false
JONSOC_DISABLE_MODELS_FETCH=false
JONSOC_ENABLE_EXPERIMENTAL_MODELS=false

# GitHub Integration
OIDC_BASE_URL=
